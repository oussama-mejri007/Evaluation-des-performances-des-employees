# ============================================================
# BACKEND — Variables d'environnement (copiez ce fichier en .env)
# ============================================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rh_db?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=rh_db

# JWT
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING

# GROQ AI (obtenez une clé sur https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Environnement
NODE_ENV=development
